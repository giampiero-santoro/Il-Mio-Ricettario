    {
      "id": "pp_test_01",
      "name": "Brodo di carne",
      "category": "Zuppe & Vellutate",
      "subcategory": "Zuppe di pesce e brodi",
      "servings": 6,
      "time": 300,
      "cookerType": "Elettrica",
      "potLiters": 6,
      "ingredients": [
        {
          "name": "muscolo di manzo",
          "qty": 600,
          "unit": "g"
        },
        {
          "name": "osso con midollo",
          "qty": 400,
          "unit": "g"
        },
        {
          "name": "cipolla",
          "qty": 1,
          "unit": "pezzo"
        },
        {
          "name": "carote",
          "qty": 2,
          "unit": "pezzo"
        },
        {
          "name": "sedano (coste)",
          "qty": 2,
          "unit": "pezzo"
        },
        {
          "name": "alloro",
          "qty": 2,
          "unit": "foglie"
        },
        {
          "name": "pepe in grani",
          "qty": 6,
          "unit": "pezzo"
        },
        {
          "name": "sale grosso",
          "qty": 1,
          "unit": "cucchiaino"
        },
        {
          "name": "acqua",
          "qty": 2,
          "unit": "l"
        }
      ],
      "steps": [
        {
          "text": "Metti nella pentola carne, ossa, cipolla tagliata a metà, carote, sedano, alloro, pepe e sale; versa l'acqua senza superare i due terzi della pentola."
        },
        {
          "text": "Chiudi il coperchio con la valvola chiusa e cuoci in pressione; lascia sfiatare da sola fino alla fine.",
          "fn": "zuppa",
          "level": "alta",
          "time": 60,
          "valve": "chiusa",
          "pressureRelease": "Naturale",
          "minLiquid": 1500,
          "fillMax": "2/3"
        },
        {
          "text": "Apri, rimetti il coperchio con la valvola su sfiato e prosegui in cottura lenta bassa: il brodo diventa più limpido e saporito.",
          "fn": "lenta",
          "level": "bassa",
          "time": 180,
          "valve": "sfiato"
        },
        {
          "text": "Filtra il brodo con un colino, sgrassalo quando è freddo e conservalo in frigo o in freezer. La carne si può servire con salsa verde."
        }
      ],
      "tags": [],
      "allergens": [
        "Sedano"
      ],
      "freezable": true,
      "notes": "Si può preparare anche in anticipo: dopo la cottura lenta si fredda, si sgrassa e si conserva.",
      "raccolte": [
        "pp_raccolta_test"
      ]
    },
    {
      "id": "pp_test_02",
      "name": "Ceci senza ammollo",
      "category": "Altro",
      "subcategory": "Contorni e insalate",
      "servings": 4,
      "time": 100,
      "cookerType": "Elettrica",
      "potLiters": 6,
      "ingredients": [
        {
          "name": "ceci secchi",
          "qty": 400,
          "unit": "g"
        },
        {
          "name": "acqua",
          "qty": 1200,
          "unit": "ml"
        },
        {
          "name": "aglio",
          "qty": 2,
          "unit": "spicchi"
        },
        {
          "name": "alloro",
          "qty": 2,
          "unit": "foglie"
        },
        {
          "name": "rosmarino",
          "qty": 1,
          "unit": "rametto"
        },
        {
          "name": "olio extravergine di oliva",
          "qty": 3,
          "unit": "cucchiai"
        },
        {
          "name": "sale",
          "qty": 1,
          "unit": "cucchiaino"
        }
      ],
      "steps": [
        {
          "text": "Sciacqua bene i ceci sotto l'acqua corrente e mettili nella pentola con l'acqua, l'aglio, l'alloro e il rosmarino. Non salare ora."
        },
        {
          "text": "Chiudi con valvola chiusa e cuoci i ceci ancora secchi; lascia sfiatare da sola fino alla fine.",
          "fn": "fagioli",
          "level": "alta",
          "time": 45,
          "valve": "chiusa",
          "pressureRelease": "Naturale",
          "minLiquid": 1000,
          "fillMax": "1/2"
        },
        {
          "text": "Apri, elimina aglio e rametti, aggiungi sale e olio e fai insaporire senza chiudere la valvola.",
          "fn": "lenta",
          "level": "alta",
          "time": 30,
          "valve": "sfiato"
        },
        {
          "text": "Servi i ceci con un filo d'olio e pepe, oppure usali per zuppe, insalate e hummus."
        }
      ],
      "tags": [
        "Vegano",
        "Senza glutine",
        "Senza lattosio"
      ],
      "allergens": [],
      "freezable": true,
      "notes": "I legumi gonfiano e fanno schiuma: non superare mai la metà della pentola.",
      "raccolte": [
        "pp_raccolta_test"
      ]
    },
