    {
      "id": "pp_test_05",
      "name": "Cheesecake in pentola nella pentola",
      "category": "Dolci",
      "subcategory": "Torte e ciambelle",
      "servings": 8,
      "time": 110,
      "cookerType": "Elettrica",
      "potLiters": 6,
      "ingredients": [
        {
          "name": "biscotti secchi (digestive)",
          "qty": 150,
          "unit": "g"
        },
        {
          "name": "burro fuso",
          "qty": 60,
          "unit": "g"
        },
        {
          "name": "formaggio fresco spalmabile",
          "qty": 500,
          "unit": "g"
        },
        {
          "name": "yogurt greco",
          "qty": 100,
          "unit": "g"
        },
        {
          "name": "uova",
          "qty": 2,
          "unit": "pezzo"
        },
        {
          "name": "zucchero",
          "qty": 100,
          "unit": "g"
        },
        {
          "name": "amido di mais",
          "qty": 1,
          "unit": "cucchiaio"
        },
        {
          "name": "estratto di vaniglia",
          "qty": 1,
          "unit": "cucchiaino"
        },
        {
          "name": "acqua",
          "qty": 250,
          "unit": "ml"
        }
      ],
      "steps": [
        {
          "text": "Trita i biscotti, uniscili al burro fuso e premi la base in uno stampo springform da 16-18 cm rivestito di carta forno; metti in freezer 10 minuti."
        },
        {
          "text": "Intiepidisci formaggio e yogurt a calore dolce per una crema più liscia, senza grumi.",
          "fn": "yogurt",
          "time": 20,
          "valve": "sfiato"
        },
        {
          "text": "Frusta formaggio e yogurt con zucchero, amido e vaniglia, aggiungi le uova una alla volta senza montare. Versa nello stampo e copri con alluminio, ben chiuso."
        },
        {
          "text": "Versa 250 ml di acqua nella pentola, metti il trepiede e poggia lo stampo sul trepiede. Chiudi e cuoci a pressione bassa; lascia sfiatare 10 minuti, poi rilascia il resto.",
          "fn": "dolci",
          "level": "bassa",
          "time": 35,
          "valve": "chiusa",
          "pressureRelease": "Naturale",
          "pressureReleaseMin": 10,
          "minLiquid": 375,
          "accessories": [
            "pentola-nella-pentola",
            "trepiede",
            "stampo",
            "alluminio"
          ]
        },
        {
          "text": "Togli l'alluminio, lascia raffreddare a temperatura ambiente, poi in frigo almeno 6 ore prima di sformare."
        }
      ],
      "tags": [
        "Vegetariano"
      ],
      "allergens": [
